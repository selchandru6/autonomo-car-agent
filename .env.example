# Copy to .env and fill in. Never commit .env.
# Only two secrets exist in this system (requirements 7.10).

# Model API key for the single ambiguous-package-text step. Leave empty to run
# fully deterministic; model_status is recorded as "down" and ambiguous
# fields are stored as UNKNOWN. This never fails a dealer.
CARSHOP_MODEL_API_KEY=

# SMTP URL, e.g. smtp://user:pass@smtp.example.com:587?starttls=true
# Leave empty to write the digest to /data/digests/ instead of sending.
CARSHOP_SMTP_URL=

# Non-secret runtime settings (defaults shown).
CARSHOP_ENV=dev
CARSHOP_DATA_DIR=./data
CARSHOP_DIGEST_RECIPIENTS=
CARSHOP_LOG_LEVEL=INFO
CARSHOP_OTEL_EXPORTER_OTLP_ENDPOINT=

# Honest identification (requirements v1.3 §4 Compliance; ADR 0002). Sent as From: on every
# browser request when set. Strongly recommended.
CARSHOP_CONTACT_EMAIL=
# identified (default) | chrome | native
CARSHOP_BROWSER_UA_MODE=identified

# Politeness baselines (requirements 7.4, v1.3).
CARSHOP_CONCURRENCY_DEALERS=4
CARSHOP_PER_HOST_MIN_PAUSE_S=5
CARSHOP_PER_HOST_MAX_PAUSE_S=10
CARSHOP_BRANCH_TIMEOUT_S=600
CARSHOP_RUN_WALL_CLOCK_S=3600

# Registry (requirements 7.1, F1, F25). Monthly locator snapshot for Texas.
CARSHOP_LOCATOR_STATE=TX
CARSHOP_LOCATOR_SEED_ZIPS=76801,79901,78520
CARSHOP_LOCATOR_RADIUS_MILES=500
CARSHOP_REGISTRY_REFRESH_DAYS=30
# Operator overrides file; default is the packaged src/carshop/config/registry/overrides.yaml
CARSHOP_REGISTRY_OVERRIDES_PATH=
